<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.MainPage"
             Title="Cadastro de Eventos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Cadastro de Evento" FontSize="24" HorizontalOptions="Center" FontAttributes="Bold" TextColor="CadetBlue" />

            <Entry x:Name="txt_nome" Placeholder="Nome do Evento" />
            <Entry x:Name="txt_local" Placeholder="Local do Evento" />
            
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <VerticalStackLayout>
                    <Label Text="Data de Início:" FontAttributes="Bold" />
                    <DatePicker x:Name="dtp_inicio" Format="dd/MM/yyyy" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="Data de Término:" FontAttributes="Bold" />
                    <DatePicker x:Name="dtp_termino" Format="dd/MM/yyyy" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Entry x:Name="txt_participantes" Placeholder="Número de Participantes" Keyboard="Numeric" />
            <Entry x:Name="txt_custo" Placeholder="Custo por Participante (R$)" Keyboard="Numeric" />

            <Button Text="Calcular e Resumir" Clicked="OnCalcularClicked" Margin="0,15,0,0" BackgroundColor="CadetBlue" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.ResumoEventoPage"
             Title="Resumo do Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="🎉 Resumo do Evento Cadastrado" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="CadetBlue" />

            <Frame BorderColor="CadetBlue" CornerRadius="10" Padding="15" Margin="0,10,0,10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Nome, StringFormat='Nome do Evento: {0}'}" FontSize="18" FontAttributes="Bold" />
                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" FontSize="16" />
                    <Label Text="{Binding DataInicio, StringFormat='Data de Início: {0:dd/MM/yyyy}'}" FontSize="14" />
                    <Label Text="{Binding DataTermino, StringFormat='Data de Término: {0:dd/MM/yyyy}'}" FontSize="14" />
                    
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5" />

                    <Label Text="{Binding DuracaoDias, StringFormat='Duração do Evento: {0} dias'}" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding NumeroParticipantes, StringFormat='Total de Participantes: {0}'}" FontSize="14" />
                    <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por Pessoa: {0:C}'}" FontSize="14" />
                    
                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,5" />

                    <Label Text="{Binding CustoTotal, StringFormat='VALOR TOTAL DO EVENTO: {0:C}'}" FontSize="18" FontAttributes="Bold" TextColor="DarkGreen" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Cadastrar Novo Evento" Clicked="OnVoltarClicked" BackgroundColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>